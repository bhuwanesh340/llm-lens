# LLM Lens — environment configuration (T007)
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Application ---
APP_NAME=LLM Lens
APP_ENV=development
APP_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# --- PostgreSQL ---
POSTGRES_USER=llm_lens
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=llm_lens
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://llm_lens:change-me-in-production@localhost:5432/llm_lens

# --- LiteLLM Gateway ---
LITELLM_PORT=4000
# Generate with: python -c "import secrets; print('sk-' + secrets.token_hex(24))"
LITELLM_MASTER_KEY=sk-change-me-in-production
# Shared secret between the backend and litellm/custom_callbacks.py (T031/T032)
LITELLM_CALLBACK_TOKEN=change-me-in-production

# --- Provider credentials (used by litellm/config.yaml) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Backend ports ---
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Admin auth (FR-023 — operator-configured, no hard-coded defaults) ---
ADMIN_EMAIL=admin@example.com
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Privacy (constitution Principle II — defaults MUST stay false) ---
STORE_PROMPTS=false
STORE_RESPONSES=false
REQUEST_RETENTION_DAYS=90
